{
  "print_eggs": false,
  "snapshot_config": {
    "theme": "vercel@https://raw.githubusercontent.com/Railly/one-hunter-vscode/refs/heads/main/themes/OneHunter-Vercel-color-theme.json",
    "window": {
      "mac_window_bar": true,
      "shadow": {
        "radius": 0,
        "color": "#00000040"
      },
      "margin": {
        "x": 0,
        "y": 0
      },
      "border": {
        "width": 0,
        "color": "#ffffff30"
      },
      "title_config": {
        "color": "#ffffff",
        "font_family": "DankMono Nerd Font"
      },
      "radius": 12
    },
    "code_config": {
      "font_family": "DankMono Nerd Font",
      "breadcrumbs": {
        "enable": true,
        "separator": "/",
        "color": "#80848b",
        "font_family": "DankMono Nerd Font"
      }
    },
    "watermark": {
      "content": "n i v x",
      "font_family": "DankMono Nerd Font",
      "color": "#ffffff"
    },
    "background": {
      "start": {
        "x": 0,
        "y": 0
      },
      "end": {
        "x": "max",
        "y": 0
      },
      "stops": [
        {
          "position": 0,
          "color": "#6bcba5"
        },
        {
          "position": 1,
          "color": "#caf4c2"
        }
      ]
    }
  }
}
